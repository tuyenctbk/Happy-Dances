        <path
            android:pathData="M16,14 C23,10 32,18 29,40 C27,52 17,58 12,55"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="2"
            android:strokeLineCap="round"/>
        <!-- Ribbons -->
        <path
            android:pathData="M12,20 C18,12 28,10 32,4 M8,32 C15,22 28,24 35,18"
            android:strokeColor="#FFC1CC"
            android:strokeWidth="3"
            android:strokeLineCap="round"/>
    </group>

    <!-- Right Ballet Slipper Motif -->
    <group
        android:translateX="115"
        android:translateY="45"
        android:scaleX="1.2"
        android:scaleY="1.2">
        <path
            android:pathData="M10,12 C20,6 36,14 32,44 C29,58 16,68 8,64 C1,59 0,38 4,24 Z"
            android:fillColor="#E87A90"/>
        <path
            android:pathData="M11,16 C18,11 28,18 26,39 C24,50 15,56 10,53"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="2"
            android:strokeLineCap="round"/>
        <path
