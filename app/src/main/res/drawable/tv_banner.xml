            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="320"
                android:endY="180"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFF0F5"/>
                <item android:offset="0.5" android:color="#FFD1DC"/>
                <item android:offset="1.0" android:color="#AEC6CF"/>
