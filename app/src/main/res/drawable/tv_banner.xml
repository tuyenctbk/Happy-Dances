    <!-- Star / Sparkles decoration -->
    <!-- Star 1 -->
    <path
        android:pathData="M190,40 L193,48 L201,51 L193,54 L190,62 L187,54 L179,51 L187,48 Z"
        android:fillColor="#FFD54F"/>
    <!-- Star 2 -->
    <path
        android:pathData="M245,65 L247,71 L253,73 L247,75 L245,81 L243,75 L237,73 L243,71 Z"
        android:fillColor="#FFD54F"/>
    <!-- Star 3 -->
    <path
        android:pathData="M60,110 L62,115 L67,117 L62,119 L60,124 L58,119 L53,117 L58,115 Z"
        android:fillColor="#FFFFFF"/>

    <!-- Happy Dances Brand Title Elements -->
    <group
        android:translateX="175"
        android:translateY="85">
        <!-- Outer glow line for brand banner -->
        <path
            android:pathData="M0,45 L130,45"
            android:strokeColor="#80FFFFFF"
            android:strokeWidth="3"
            android:strokeLineCap="round"/>
    </group>

</vector>
